{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Win-Optimizer-Pro",
  "version": "2.1.4",
  "identifier": "com.winoptimizerpro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Win-Optimizer-Pro",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "zip"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../optimizer.ps1", "../engine.ps1", "../winutil.ps1"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
